# Preserve the original Windows distribution byte for byte.
*.exe binary
*.dll binary
*.png binary
/tool/* -text
/prepared/**/db.err -text
/history.txt -text

# Repository documentation and metadata use consistent line endings.
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.gitkeep text eol=lf
